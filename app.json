{
  "expo": {
    "name": "GoOn",
    "slug": "goon-guest-mode",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./frontend/assets/icon1.png",
    "userInterfaceStyle": "light",
    "scheme": "goon",
    "splash": {
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.goon.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.goon.app"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "0abd9a19-9ce0-4e08-b036-d1256ac3cabd"
      }
    }
  }
}
