# PORT=3000
# MONGODB_URI=mongodb://localhost:27017/notification_app
# NODE_ENV=development
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service.json
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_CONTENT\n-----END PRIVATE KEY-----\n"
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key":"-----BEGIN PRIVATE KEY-----\\nYOUR_PRIVATE_KEY_CONTENT\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"}
# Optional allowlist for platform administrators. Leave empty to deny Super Admin access.
# SUPER_ADMIN_UIDS=firebase-uid-1,firebase-uid-2
# Stripe Connect platform settings. Return/refresh URLs should lead back to GoOn.
# STRIPE_SECRET_KEY=
# STRIPE_CONNECT_RETURN_URL=
# STRIPE_CONNECT_REFRESH_URL=
# PayPal Commerce Platform partner settings.
# PAYPAL_MODE=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_PARTNER_ID=
# PAYPAL_PARTNER_ATTRIBUTION_ID=
# PAYPAL_CONNECT_RETURN_URL=
# Public HTTPS backend URL used by provider return URLs.
# ONLINE_PAYMENT_API_BASE_URL=https://api.example.com
# HTTPS app landing URL after provider return.
# ONLINE_PAYMENT_RETURN_URL=https://app.example.com/payment-result
# Stripe Connect webhook endpoint must subscribe to connected-account events.
# STRIPE_CONNECT_WEBHOOK_SECRET=
# PayPal webhook ID for seller onboarding and payment/capture events.
# PAYPAL_WEBHOOK_ID=
