{
  "name": "notification-app-backend",
  "version": "1.0.0",
  "description": "Backend for Expo Push Notification test app",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "test:profile": "node --test tests/profile-persistence.test.js",
    "push:audit": "node scripts/auditPushReadiness.js",
    "purge:test-data": "node scripts/purgeTestData.js",
    "purge:legacy-expo-tokens": "node scripts/purgeLegacyExpoTokens.js",
    "purge:legacy-expo-tokens:apply": "DRY_RUN=false CONFIRM_PURGE=YES_I_AM_SURE node scripts/purgeLegacyExpoTokens.js"
  },
  "dependencies": {
    "cloudinary": "^2.8.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "file-type": "^21.3.4",
    "firebase-admin": "^13.10.0",
    "mongoose": "^8.24.0",
    "multer": "^2.1.1",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
